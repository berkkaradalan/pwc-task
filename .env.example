# Copy to .env and adjust. Never commit .env.

# PostgreSQL container credentials (used by docker-compose.yml).
POSTGRES_USER=oncall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oncall

# Host ports published by docker-compose.yml (change them if already in use).
POSTGRES_HOST_PORT=5432
OLLAMA_HOST_PORT=11434
API_HOST_PORT=8000

# Memory limit of the Ollama container; the default in docker-compose.yml is 6g.
# OLLAMA_MEMORY_LIMIT=6g

# Connection string for running the app on the host against the compose database.
# Inside compose, the ingest service overrides this to point at the `db` service.
DATABASE_URL=postgresql://oncall:change-me@localhost:5432/oncall

# Ollama embedding model. Inside compose, the base URL is overridden to the `ollama` service.
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Chunking (characters).
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Folder with the documents to ingest, relative to the working directory.
DOCS_DIR=data/docs

# Question answering (the `api` service).
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SIMILARITY=0.5
LLM_MAX_CONCURRENCY=4
DB_POOL_MAX_SIZE=10

# Language model: keep exactly one of the two blocks below active.
# Embeddings always come from the local Ollama service, so both blocks pull EMBEDDING_MODEL.

# --- Local (Ollama), active by default: no account or API key needed. ---
# Address inside Compose; use http://localhost:${OLLAMA_HOST_PORT}/v1 to run the API on the host.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Ollama ignores the key, but the client requires one.
LLM_API_KEY=ollama
# CPU-only generation is slow.
LLM_TIMEOUT_SECONDS=120
OLLAMA_PULL_MODELS="qwen3-embedding:0.6b qwen3:4b-instruct-2507-q4_K_M"

# --- Cloud (OpenRouter): comment out the local block above and uncomment this one. ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-3.1-flash-lite
# LLM_API_KEY=your-openrouter-api-key
# LLM_TIMEOUT_SECONDS=60
# OLLAMA_PULL_MODELS="qwen3-embedding:0.6b"
