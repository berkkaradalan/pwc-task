# Copy to .env and adjust. Never commit .env.

# PostgreSQL container credentials (used by docker-compose.yml).
POSTGRES_USER=oncall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oncall

# Host ports published by docker-compose.yml (change them if already in use).
POSTGRES_HOST_PORT=5432
OLLAMA_HOST_PORT=11434
API_HOST_PORT=8000

# Memory limit of the Ollama container; the default in docker-compose.yml is 6g.
# OLLAMA_MEMORY_LIMIT=6g

# Connection string for running the app on the host against the compose database.
# Inside compose, the ingest service overrides this to point at the `db` service.
DATABASE_URL=postgresql://oncall:change-me@localhost:5432/oncall

# Run mode: `local` (Ollama, no account or key needed) or `cloud` (OpenRouter).
# Switching changes the embedding model, so the next ingestion rebuilds the index.
RUN_MODE=local

# Local mode. Inside compose, the base URL is overridden to the `ollama` service.
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Cloud mode. Create a key at https://openrouter.ai/settings/keys.
CLOUD_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
CLOUD_LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# OPENROUTER_API_KEY=your-openrouter-api-key

# Embeddings in both modes: vectors are truncated to EMBEDDING_DIM by the provider.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Chunking (characters).
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Folder with the documents to ingest, relative to the working directory.
DOCS_DIR=data/docs

# Question answering (the `api` service).
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SIMILARITY=0.5
LLM_MAX_CONCURRENCY=4
# CPU-only generation in local mode is slow.
LLM_TIMEOUT_SECONDS=120
DB_POOL_MAX_SIZE=10
